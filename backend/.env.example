PORT=5000
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=0
# Local MongoDB or MongoDB Atlas URI:
MONGO_URI=mongodb://127.0.0.1:27017/agritech_db
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/agritech_db?retryWrites=true&w=majority
# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=30d
NODE_ENV=development
